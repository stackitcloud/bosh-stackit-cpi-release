#!/bin/bash

set -e -x


mkdir -p "${BOSH_INSTALL_TARGET}"/bin


PLATFORM=`uname | tr '[:upper:]' '[:lower:]'`

if [ -z "${BOSH_PACKAGES_DIR}" ]; then
	PKG_DIR="$(readlink -nf /var/vcap/packages/golang-1-${PLATFORM})"
else
	PKG_DIR="${BOSH_PACKAGES_DIR}/golang-1-${PLATFORM}"
fi

source "${PKG_DIR}/bosh/compile.env"

# Since HOME is not set we must set GOPATH and GOCACHE
mkdir -p /tmp/go/.cache
export GOPATH=/tmp/go
export GOCACHE=${GOPATH}/.cache

cd "${BOSH_COMPILE_TARGET}/stackit-cpi"

# gosigar won't build on macos when statically linking. It's pulled in via the agent dependencies.
if [[ "${PLATFORM}" != "darwin" ]]; then
  export CGO_ENABLED=0
fi

go build -o stackit_cpi
cp -a \
  "${BOSH_COMPILE_TARGET}/stackit-cpi/stackit_cpi" \
  "${BOSH_INSTALL_TARGET}/bin/stackit-cpi"
